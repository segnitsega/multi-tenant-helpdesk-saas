NODE_ENV=development
APP_URL=http://localhost:3000

# Neon (or any Postgres). Use the DIRECT (non-pooler) URL for MIGRATE_DATABASE_URL.
# After creating app_user / system_user_role, point DATABASE_URL and DATABASE_URL_SYSTEM at those roles.
DATABASE_URL=postgresql://app_user:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_SYSTEM=postgresql://system_user_role:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
MIGRATE_DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

REDIS_URL=redis://localhost:6379

AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

MAIL_DOMAIN=mail.localhost
MAIL_FROM_NAME=Relay
SMTP_URL=smtp://localhost:1025
POSTMARK_SERVER_TOKEN=
POSTMARK_INBOUND_USER=
POSTMARK_INBOUND_PASS=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=relay-dev
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345

SENTRY_DSN=

NODE_ENV=development
APP_URL=http://localhost:3000

# Neon (or any Postgres). Prefer DIRECT hosts (no -pooler) with Prisma 8 —
# Neon poolers reject Prisma session startup options (e.g. lc_monetary).
# MIGRATE_DATABASE_URL = owner + direct host for schema changes.
# DATABASE_URL = app_user (RLS applies).
# DATABASE_URL_SYSTEM = system role (can bypass RLS). Use strong passwords.
DATABASE_URL=postgresql://app_user:STRONG_PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_SYSTEM=postgresql://system_user_role:STRONG_PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
MIGRATE_DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

REDIS_URL=redis://localhost:6379

AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

MAIL_DOMAIN=mail.localhost
MAIL_FROM_NAME=Relay
SMTP_URL=smtp://localhost:1025
POSTMARK_SERVER_TOKEN=
POSTMARK_INBOUND_USER=
POSTMARK_INBOUND_PASS=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=relay-dev
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345

SENTRY_DSN=

# Optional Playwright e2e
# E2E_USER_EMAIL=demo@relay.local
# E2E_USER_PASSWORD=password123
# E2E_WORKSPACE_SLUG=demo
# PLAYWRIGHT_BASE_URL=http://localhost:3000

